{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Get Users Response Schema",
  "type": "object",
  "properties": {
    "pageable": {
      "type": "object",
      "properties": {
        "pageNo": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "pages": { "type": "integer" },
        "size": { "type": "integer" }
      },
      "required": ["pageNo", "pageSize", "pages", "size"]
    },

    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userName": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string" },
          "federatedIdentity": { "type": "string" },
          "roles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "isBlocked": { "type": "boolean" },
          "createdBy": { "type": "string" },
          "updatedBy": { "type": "string" },
          "createdTimestamp": { "type": "string" },
          "updatedTimestamp": { "type": "string" }
        },
        "required": [
          "id",
          "userName",
          "firstName",
          "lastName",
          "fullName",
          "email",
          "federatedIdentity",
          "roles",
          "isBlocked"
        ]
      }
    }
  },

  "required": ["pageable", "items"]
}
