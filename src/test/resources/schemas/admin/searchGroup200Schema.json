{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GroupListSchema",
  "type": "object",

  "properties": {
    "pageable": {
      "type": "object",
      "properties": {
        "pageNo": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "pages": { "type": "integer" },
        "size": { "type": "integer" }
      },
      "required": ["pageNo", "pageSize", "pages", "size"]
    },

    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Group ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-zA-Z0-9-_.@]+$"
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^$|^[a-zA-Z0-9-_., ]+$"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "createdTimestamp": {
            "type": "string"
          },
          "updatedTimestamp": {
            "type": "string"
          },
          "roles": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "federatedIdentity": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "description",
          "createdBy",
          "updatedBy",
          "createdTimestamp",
          "updatedTimestamp",
          "federatedIdentity"
        ]
      }
    }
  },

  "required": ["pageable", "items"]
}
