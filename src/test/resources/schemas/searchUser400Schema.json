{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": ["ConstraintViolation"]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldName": {
            "type": "string"
          },
          "violation": {
            "type": "string"
          }
        },
        "required": ["fieldName", "violation"],
        "additionalProperties": false
      }
    }
  },
  "required": ["code", "messages"],
  "additionalProperties": false
}
