{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "userName",
    "firstName",
    "lastName",
    "fullName",
    "email",
    "federatedIdentity",
    "roles",
    "isBlocked",
    "createdBy",
    "updatedBy",
    "createdTimestamp",
    "updatedTimestamp"
  ],
  "properties": {
    "id": { "type": "string" },
    "userName": { "type": "string" },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "fullName": { "type": "string" },
    "email": {
      "type": "string",
      "format": "email"
    },
    "federatedIdentity": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "isBlocked": { "type": "boolean" },
    "createdBy": { "type": "string" },
    "updatedBy": { "type": "string" },
    "createdTimestamp": { "type": "string" },
    "updatedTimestamp": { "type": "string" }
  }
}
